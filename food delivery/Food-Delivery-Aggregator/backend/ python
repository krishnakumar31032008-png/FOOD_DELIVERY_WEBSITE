import sqlite3

# Database connection
con = sqlite3.connect("food_delivery.db")
cur = con.cursor()

# Create tables
cur.execute("""
CREATE TABLE IF NOT EXISTS restaurants(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT,
    food TEXT,
    price REAL
)
""")

cur.execute("""
CREATE TABLE IF NOT EXISTS orders(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    customer TEXT,
    restaurant TEXT,
    food TEXT,
    price REAL
)
""")

con.commit()

# Add restaurant
def add_restaurant():
    name = input("Enter restaurant name: ")
    food = input("Enter food name: ")
    price = float(input("Enter food price: "))

    cur.execute(
        "INSERT INTO restaurants(name,food,price) VALUES(?,?,?)",
        (name, food, price)
    )
    con.commit()
    print("Restaurant added successfully!")

# View restaurants
def view_restaurants():
    cur.execute("SELECT * FROM restaurants")
    for row in cur.fetchall():
        print(row)

# Place order
def place_order():
    customer = input("Enter customer name: ")
    rid = int(input("Enter restaurant ID: "))

    cur.execute("SELECT name,food,price FROM restaurants WHERE id=?", (rid,))
    item = cur.fetchone()

    if item:
        cur.execute(
            "INSERT INTO orders(customer,restaurant,food,price) VALUES(?,?,?,?)",
            (customer, item[0], item[1], item[2])
        )
        con.commit()
        print("Order placed successfully!")
        print("Total Amount:", item[2])
    else:
        print("Restaurant not found!")

# View orders
def view_orders():
    cur.execute("SELECT * FROM orders")
    for row in cur.fetchall():
        print(row)

# Main menu
while True:
    print("\n--- FOOD DELIVERY AGGREGATOR ---")
    print("1. Add Restaurant")
    print("2. View Restaurants")
    print("3. Place Order")
    print("4. View Orders")
    print("5. Exit")

    choice = input("Enter your choice: ")

    if choice == '1':
        add_restaurant()
    elif choice == '2':
        view_restaurants()
    elif choice == '3':
        place_order()
    elif choice == '4':
        view_orders()
    elif choice == '5':
        print("Thank you!")
        break
    else:
        print("Invalid choice!")

con.close()